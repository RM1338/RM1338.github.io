---
import '../styles/global.css';
import { hasResume } from '../lib/site';

interface Props {
  title: string;
  description: string;
  image?: string;
}
const { title, description, image = '/og/home.png' } = Astro.props;
const ogImage = new URL(image, Astro.site);
const email = 'rma80070@gmail.com';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta name="theme-color" content="#f3f3f1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="nav-bar">
      <div class="nav wrap">
      <a class="name" href="/">Ronel Abraham Mathew</a>
      <nav aria-label="Main">
        <a href="/#work">Work</a>
        <a href="/#about">About</a>
        {hasResume && <a href="/resume.pdf" target="_blank" rel="noopener">Résumé ↗</a>}
        <a class="hide-sm" href="https://github.com/RM1338" rel="me">GitHub</a>
        <a class="hide-sm" href="https://www.linkedin.com/in/ronelm" rel="me">LinkedIn</a>
      </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <script>
      // One name on screen at a time: while the hero's name is visible, the navbar's name steps aside.
      const hero = document.querySelector('[data-hero-name]');
      const name = document.querySelector('.nav .name');
      if (hero && name) {
        new IntersectionObserver(([e]) => name.classList.toggle('shown', !e.isIntersecting)).observe(hero);
      }
    </script>
    <footer class="foot wrap" id="contact">
      <p class="label">Contact</p>
      <p class="foot-cta">Let's talk: <a href={`mailto:${email}`}>{email}</a></p>
      <p class="foot-links">
        <a href="https://github.com/RM1338" rel="me">GitHub · RM1338</a>
        <a href="https://www.linkedin.com/in/ronelm" rel="me">LinkedIn · ronelm</a>
        <a href="https://medium.com/@ronelmathew" rel="me">Medium · ronelmathew</a>
        {hasResume && <a href="/resume.pdf" target="_blank" rel="noopener">Résumé ↗</a>}
      </p>
    </footer>
  </body>
</html>

<style>
  /* Sticky, full-width bar; its height is --nav-h so anchors and the case-study chapter strip can clear it. */
  .nav-bar { position: sticky; top: 0; z-index: 20; background: color-mix(in srgb, var(--bg) 92%, transparent); backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); }
  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    height: var(--nav-h);
  }
  .name { font-weight: 600; text-decoration: none; letter-spacing: -0.01em; transition: opacity 0.25s, transform 0.25s; }
  /* On a page whose hero shows the name, the nav's copy starts hidden (no flash on load) and appears once the hero name scrolls away. */
  :global(body:has([data-hero-name])) .name:not(.shown) { opacity: 0; transform: translateY(-4px); pointer-events: none; }
  @media (prefers-reduced-motion: reduce) { .name { transition: none; } }
  nav { display: flex; gap: 20px; font-size: 15px; }
  nav a { text-decoration: none; }
  @media (max-width: 720px) {
    .hide-sm { display: none; }
    nav { gap: 14px; }
    .name { font-size: 15px; }
  }
  .foot { padding-top: 64px; padding-bottom: 48px; margin-top: var(--section); border-top: 1px solid var(--line); }
  .foot-cta { font-family: var(--serif); font-size: clamp(26px, 3.5vw, 42px); font-weight: 400; letter-spacing: -0.01em; line-height: 1.2; overflow-wrap: anywhere; }
  .foot-links { display: flex; flex-wrap: wrap; gap: 12px 28px; font: 500 14px/1.4 var(--mono); }
</style>
