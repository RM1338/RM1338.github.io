---
// Scribe's side quest: "Pack it right", an arcade. Each piece of a meeting's data (and each key) drops in
// against a timer; send it where Scribe really keeps it. Answers follow Scribe's code.
import QuestShell from './QuestShell.astro';

const bins = { phone: 'Phone', server: 'Server', account: 'Your account' } as const;
// [item, where it lives, one-line reason shown only when you get it wrong]
const items: [string, keyof typeof bins, string][] = [
  ['Audio recording', 'phone', 'Recordings stay on the phone.'],
  ['Scribe’s shared API key', 'server', 'The shared key never ships in the app.'],
  ['Transcript', 'account', 'Text syncs to your account.'],
  ['Your own API key', 'phone', 'Your own key lives in the app’s settings.'],
  ['Supabase anon key', 'phone', 'Trick: it ships in the app on purpose. It is public by design.'],
  ['Folders', 'account', 'Text syncs to your account.'],
  ['Summary', 'account', 'Text syncs to your account.'],
  ['Scheduled meetings', 'account', 'Text syncs to your account.'],
];
---

<QuestShell id="key-game">
  <img slot="peek" src="/brand/scribe-mark.png" alt="" width="56" height="56" />

  <div class="kg" data-kg data-items={JSON.stringify(items)}>
    <div class="top">
      <div>
        <p class="label">Side quest</p>
        <h2>Pack it right.</h2>
        <p class="rules">Things from a meeting drop in. Send each one where Scribe keeps it, before the timer runs out.</p>
      </div>
      <div class="hud">
        <span class="lives" data-kg-lives aria-label="Lives"></span>
        <span>Score <b data-kg-score>0</b></span>
        <span class="combo" data-kg-combo></span>
      </div>
    </div>

    <div class="stage">
      <div class="drop" data-kg-drop><span class="muted">Ready when you are.</span></div>
      <div class="timer"><i data-kg-timer></i></div>
      <p class="flash" data-kg-flash aria-live="polite"></p>
      <div class="bins">
        {Object.entries(bins).map(([k, label], n) => (
          <button type="button" class="bin" data-bin={k} disabled>
            <span class="bin-name">{label}</span><kbd>{n + 1}</kbd>
          </button>
        ))}
      </div>
    </div>
    <div class="end" data-kg-end hidden></div>
    <button type="button" class="btn btn-solid go" data-kg-go>Start</button>
  </div>
</QuestShell>

<script>
  const root = document.querySelector<HTMLElement>('[data-kg]');
  if (root) {
    const ITEMS: [string, string, string][] = JSON.parse(root.dataset.items!);
    const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const drop = $('[data-kg-drop]'), bar = $('[data-kg-timer]'), flash = $('[data-kg-flash]'), end = $('[data-kg-end]'), go = $<HTMLButtonElement>('[data-kg-go]');
    const bins = [...root.querySelectorAll<HTMLButtonElement>('[data-bin]')];
    const ROUNDS = 16;
    let deck: [string, string, string][] = [], cur: [string, string, string] | null = null;
    let lives = 3, score = 0, combo = 0, round = 0, right = 0, playing = false, timeout = 0;

    const hud = () => {
      $('[data-kg-lives]').textContent = '●'.repeat(lives) + '○'.repeat(3 - lives);
      $('[data-kg-score]').textContent = `${score}`;
      $('[data-kg-combo]').textContent = combo > 1 ? `×${combo} combo` : '';
    };
    const say = (t: string, kind = '') => { flash.textContent = t; flash.className = `flash ${kind}`; };
    const shuffle = <T,>(a: T[]) => a.map((x) => [Math.random(), x] as const).sort((p, q) => p[0] - q[0]).map(([, x]) => x);

    const next = () => {
      if (!playing) return;
      if (round >= ROUNDS || lives <= 0) return finish();
      round++;
      if (!deck.length) deck = shuffle(ITEMS);
      cur = deck.pop()!;
      drop.innerHTML = `<span class="item">${cur[0]}</span>`;
      drop.classList.remove('in'); void drop.offsetWidth; drop.classList.add('in');
      bins.forEach((b) => { b.disabled = false; b.classList.remove('good', 'wrong'); });
      const ms = Math.max(1700, 4200 - round * 150);
      bar.style.transition = 'none'; bar.style.transform = 'scaleX(1)';
      requestAnimationFrame(() => requestAnimationFrame(() => { bar.style.transition = `transform ${ms}ms linear`; bar.style.transform = 'scaleX(0)'; }));
      clearTimeout(timeout);
      timeout = window.setTimeout(() => answer(null), ms);
    };

    const answer = (bin: string | null) => {
      if (!cur || !playing) return;
      clearTimeout(timeout);
      const [, where, why] = cur; cur = null;
      bins.forEach((b) => (b.disabled = true));
      root.querySelector(`[data-bin="${where}"]`)!.classList.add('good');
      if (bin === where) { right++; combo++; score += 10 * combo; say(combo > 2 ? 'Nice streak.' : 'Packed.', 'ok'); }
      else {
        lives--; combo = 0;
        if (bin) root.querySelector(`[data-bin="${bin}"]`)!.classList.add('wrong');
        say(`${bin ? 'Wrong bin.' : 'Too slow.'} ${why}`, 'bad');
      }
      hud();
      setTimeout(next, bin === where ? 450 : 1300);
    };

    const finish = () => {
      playing = false; clearTimeout(timeout);
      bins.forEach((b) => { b.disabled = true; b.classList.remove('good', 'wrong'); });
      bar.style.transition = 'none'; bar.style.transform = 'scaleX(0)'; say('');
      let best = score;
      try { best = Math.max(score, +(localStorage.getItem('kg-best') || 0)); localStorage.setItem('kg-best', `${best}`); } catch { /* fine */ }
      drop.innerHTML = '';
      end.hidden = false;
      end.innerHTML = `<p class="big">${lives > 0 ? 'All packed.' : 'Out of lives.'} <b>${score}</b> points</p>
        <p>Best ${best} · ${right} of ${round} right</p>
        <p class="muted">Scribe’s three rules: audio stays on your phone, text follows you to your account, and the key that can spend money never leaves the server.</p>`;
      go.hidden = false; go.textContent = 'Play again';
    };

    const start = () => {
      lives = 3; score = 0; combo = 0; round = 0; right = 0; deck = []; playing = true;
      end.hidden = true; go.hidden = true; say(''); hud(); next();
    };

    bins.forEach((b) => b.addEventListener('click', () => answer(b.dataset.bin!)));
    go.addEventListener('click', start);
    root.closest('[data-quest]')?.addEventListener('quest-close', () => { playing = false; clearTimeout(timeout); });
    document.addEventListener('keydown', (e) => {
      if (!playing || !cur) return;
      const n = ['1', '2', '3'].indexOf(e.key);
      if (n >= 0) answer(bins[n].dataset.bin!);
    });
    hud();
  }
</script>

<style>
  /* One centered column, like Whack-a-bug: heading, score, stage, result and button share an axis. */
  .kg { max-width: 760px; margin: 0 auto; text-align: center; }
  .top { display: flex; flex-direction: column; align-items: center; gap: 14px; }
  .top h2 { margin: 6px 0 8px; }
  .rules { margin: 0; color: var(--muted); text-wrap: balance; }
  .hud { display: flex; justify-content: center; gap: 20px; align-items: center; font: 400 15px var(--mono); }
  .hud b { font-weight: 500; }
  .lives { color: #c93a32; letter-spacing: 3px; font-size: 18px; }
  .hud { flex-wrap: wrap; }
  .combo { color: var(--accent); flex-basis: 100%; min-height: 1.3em; text-align: center; } /* own line, so an empty combo never shifts the centered score */
  .stage { margin-top: 24px; border: 1.5px solid var(--ink); background: var(--surface); padding: 22px; }
  .drop { min-height: 88px; display: grid; place-items: center; }
  .drop :global(.item) { font-family: var(--serif); font-size: clamp(26px, 3.4vw, 38px); }
  .drop:global(.in) :global(.item) { animation: drop-in 0.35s cubic-bezier(0.2, 0.9, 0.3, 1.3); }
  @keyframes drop-in { from { opacity: 0; transform: translateY(-24px) scale(0.96); } }
  .timer { height: 6px; background: var(--line); border-radius: 3px; overflow: hidden; margin-top: 10px; }
  .timer i { display: block; height: 100%; background: var(--ink); transform-origin: left; transform: scaleX(0); }
  .flash { margin: 12px 0; min-height: 1.5em; font-weight: 500; text-align: center; }
  .flash:global(.ok) { color: #1f8a4c; }
  .flash:global(.bad) { color: #c93a32; }
  .bins { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .bin { display: flex; flex-direction: column; align-items: center; gap: 4px; padding: 18px 8px; border: 1.5px dashed var(--ink); border-radius: 12px; background: var(--bg); cursor: pointer; font-size: 17px; color: var(--ink); transition: transform 0.12s, background 0.2s; }
  .bin:not(:disabled):hover { transform: translateY(-2px); background: #fff; }
  .bin:disabled { cursor: default; }
  .bin:global(.good) { border-style: solid; border-color: #1f8a4c; background: #e6f4ec; }
  .bin:global(.wrong) { border-style: solid; border-color: #c93a32; background: #fbeceb; }
  kbd { font: 12px var(--mono); color: var(--muted); }
  .end { margin-top: 20px; }
  .end :global(.big) { font-family: var(--serif); font-size: clamp(26px, 3vw, 34px); margin: 0 0 6px; }
  .go { margin-top: 20px; display: inline-flex; }
  .go[hidden] { display: none; }
  @media (prefers-reduced-motion: reduce) { .drop:global(.in) :global(.item) { animation: none; } .bin { transition: none; } }
</style>
