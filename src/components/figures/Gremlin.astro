---
import Stage from '../Stage.astro';
import scout from '../../assets/nib/nib-explorer.svg?raw';
import swat from '../../assets/nib/nib-chaos.svg?raw';
import report from '../../assets/nib/nib-trace.svg?raw';
---

<Stage label="Gremlin: Nib scouts the app's screens, swats the bug when a screen logs a RenderFlex overflow, then holds up the repro trace.">
  <img slot="brand" class="mark" src="/brand/gremlin-mark.svg" alt="" />
  <span slot="brand">Gremlin</span>

  <div class="actor phone" style="--x:24;--z:-2;--w:15"><span></span><span></span><span class="s"></span></div>
  <div class="actor phone bad" style="--x:50;--z:-4;--w:15">
    <span></span><span class="s"></span>
    <i>RenderFlex overflowed by 42 px</i>
  </div>
  <div class="actor phone" style="--x:76;--z:-2;--w:15"><span class="s"></span><span></span><span></span></div>

  <div class="actor nib" style="--x:50;--z:16;--w:26">
    <div class="pose p1" set:html={scout} />
    <div class="pose p2" set:html={swat} />
    <div class="pose p3" set:html={report} />
  </div>
</Stage>

<style>
  .mark { height: 4.4cqw; width: auto; }
  .phone {
    height: 27cqw;
    background: var(--surface);
    border: 0.6cqw solid #2b2b2b;
    border-radius: 2cqw;
    padding: 2.4cqw 1.4cqw;
    display: flex;
    flex-direction: column;
    gap: 1cqw;
  }
  .phone span { height: 1.2cqw; background: var(--line); }
  .phone span.s { width: 60%; }
  .phone i {
    margin-top: auto;
    font: 600 1.2cqw/1.3 var(--mono);
    font-style: normal;
    color: #fff;
    background: #d12f2f;
    padding: 0.8cqw;
    opacity: 0;
    animation: flag 9s infinite;
  }
  .bad { animation: glow 9s infinite; }
  @keyframes flag { 0%, 33% { opacity: 0; } 36%, 96% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes glow { 0%, 33%, 100% { border-color: #2b2b2b; } 36%, 66% { border-color: #d12f2f; } }
  /* Three beats: scout (the model chooses where to go), swat (the log names the bug), report (the trace). */
  .nib { display: grid; }
  .pose { grid-area: 1 / 1; opacity: 0; }
  .p1 { animation: beat1 9s infinite; }
  .p2 { animation: beat2 9s infinite; }
  .p3 { animation: beat3 9s infinite; }
  @keyframes beat1 { 0%, 30% { opacity: 1; } 33%, 97% { opacity: 0; } 100% { opacity: 1; } }
  @keyframes beat2 { 0%, 31% { opacity: 0; } 34%, 63% { opacity: 1; } 66%, 100% { opacity: 0; } }
  @keyframes beat3 { 0%, 64% { opacity: 0; } 67%, 97% { opacity: 1; } 100% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .p2 { opacity: 1; }
    .phone i { opacity: 1; }
  }
</style>
