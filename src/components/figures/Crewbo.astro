---
import Stage from '../Stage.astro';
import { boSVG, TEAM_COLORS } from '../../lib/crewbo/bo.js';
import '../../lib/crewbo/bo.css';

const [cobalt, teal, , ember] = TEAM_COLORS;
---

<Stage label="Crewbo: two teammates' agents each hold a claimed file. A third agent tries to edit session.ts, is refused because riya holds it, and backs off.">
  <img slot="brand" class="lockup" src="/brand/crewbo-lockup.svg" alt="" />

  <div class="actor file" style={`--x:34;--z:0;--w:20;--c:${cobalt.base}`}>
    <span class="fname">session.ts</span>
    <span class="who">claimed · riya</span>
    <span class="ln"></span><span class="ln s"></span><span class="ln"></span>
  </div>
  <div class="actor file" style={`--x:66;--z:0;--w:20;--c:${teal.base}`}>
    <span class="fname">limits.ts</span>
    <span class="who">claimed · dev</span>
    <span class="ln"></span><span class="ln"></span><span class="ln s"></span>
  </div>

  <div class="actor" style="--x:22;--z:14;--w:13" set:html={boSVG({ state: 'working', color: cobalt.base, size: 100, title: "riya's agent, working" })} />
  <div class="actor" style="--x:78;--z:14;--w:13" set:html={boSVG({ state: 'working', color: teal.base, size: 100, title: "dev's agent, working" })} />
  <div class="actor intruder" style="--x:52;--z:22;--w:12">
    <div set:html={boSVG({ state: 'conflict', color: ember.base, size: 100, static: true, title: "maya's agent, refused" })} />
  </div>
  <div class="actor stamp" style="--x:33;--z:6;--w:24">Refused: session.ts is claimed by riya</div>
</Stage>

<style>
  .lockup { height: 3.6cqw; width: auto; }
  .file {
    background: var(--surface);
    border: 1px solid var(--line);
    border-top: 0.8cqw solid var(--c);
    padding: 1.6cqw 1.6cqw 2cqw;
    display: flex;
    flex-direction: column;
    gap: 0.8cqw;
    height: 22cqw;
  }
  .fname { font: 600 1.9cqw/1 var(--mono); }
  .who { font: 500 1.4cqw/1 var(--mono); color: var(--c); }
  .ln { height: 0.7cqw; background: var(--line); width: 100%; }
  .ln.s { width: 60%; }
  /* The intruder walks toward the claimed file, is stopped, and backs off. */
  .intruder { animation: approach 6s cubic-bezier(0.4, 0, 0.2, 1) infinite; }
  @keyframes approach {
    0%, 12% { transform: translateX(-50%) translateZ(22cqw); }
    38%, 64% { transform: translateX(-130%) translateZ(16cqw); }
    86%, 100% { transform: translateX(-50%) translateZ(22cqw); }
  }
  .actor.stamp {
    bottom: calc(100% - 40cqw);
    background: var(--accent);
    color: #141414;
    font: 600 1.5cqw/1.3 var(--mono);
    padding: 1cqw 1.2cqw;
    filter: none;
    opacity: 0;
    animation: stamp 6s infinite;
  }
  @keyframes stamp {
    0%, 36% { opacity: 0; }
    40%, 62% { opacity: 1; }
    66%, 100% { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .actor.stamp { opacity: 1; }
  }
</style>
