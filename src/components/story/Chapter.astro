---
// One storyboard panel: a numbered frame with an illustration, and the story beside it.
// Every case study uses the same eight chapters (see src/pages/work/[slug].astro).
interface Props {
  n: string;
  kicker: string;
  title: string;
}
const { n, kicker, title } = Astro.props;
const id = kicker.toLowerCase().replaceAll(' ', '-');
---

<section class="chapter" id={id}>
  <figure class="panel">
    <figcaption class="panel-head"><span>Panel {n}</span><span>{kicker}</span></figcaption>
    <div class="panel-body"><slot name="panel" /></div>
  </figure>
  <div class="text">
    <p class="label">{n} · {kicker}</p>
    <h2>{title}</h2>
    <slot />
  </div>
</section>

<style>
  .chapter {
    display: grid;
    grid-template-columns: 6fr 5fr;
    gap: 48px;
    align-items: center;
    padding: 72px 0;
    border-top: 1px solid var(--line);
    scroll-margin-top: 64px;
  }
  .chapter:nth-of-type(even) { grid-template-columns: 5fr 6fr; }
  .chapter:nth-of-type(even) .panel { order: 2; }
  .panel { margin: 0; border: 1.5px solid var(--ink); background: var(--surface); }
  .panel-head {
    display: flex;
    justify-content: space-between;
    padding: 8px 12px;
    border-bottom: 1.5px solid var(--ink);
    font: 500 12px/1 var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .panel-body {
    container-type: inline-size;
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background:
      radial-gradient(circle at 1px 1px, var(--line) 1px, transparent 0) 0 0 / 16px 16px,
      var(--surface);
  }
  .text h2 { margin: 12px 0 20px; }
  .text :global(p) { max-width: 52ch; }
  .text :global(p.lede) { font-size: 22px; line-height: 1.45; letter-spacing: -0.01em; }
  .text :global(ul) { padding-left: 20px; max-width: 52ch; }
  .text :global(li + li) { margin-top: 8px; }
  .text :global(code) { font: 0.86em var(--mono); background: var(--bg); border: 1px solid var(--line); padding: 1px 5px; }

  /* Shared panel vocabulary, sized in cqw so every panel scales with its frame.
     .pg lays a panel out on a grid with even margins; everything inside flows in it. */
  .panel-body :global(.pg) { position: absolute; inset: 6cqw 6cqw 9cqw; display: grid; gap: 3cqw; align-content: center; align-items: center; }
  .panel-body :global(.pcap) { position: absolute; left: 6cqw; bottom: 3cqw; font: 500 2.2cqw/1 var(--mono); text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); }
  .panel-body :global(.card) { background: var(--surface); border: 1.5px solid var(--ink); padding: 2.4cqw 2.8cqw; font-size: 2.7cqw; line-height: 1.35; display: flex; flex-direction: column; gap: 0.6cqw; }
  .panel-body :global(.sub) { display: block; font-size: 2.3cqw; color: var(--muted); }
  .panel-body :global(.term) { background: #141414; color: #e8e8e4; padding: 3cqw 3.4cqw; font: 2.5cqw/1.55 var(--mono); white-space: pre-wrap; }
  .panel-body :global(.term .r) { color: #ff7b72; }
  .panel-body :global(.term .g) { color: #7ee2a8; }
  .panel-body :global(.term .m) { color: #8f8f8f; }
  .panel-body :global(.bubble) { background: var(--ink); color: var(--bg); padding: 2cqw 2.6cqw; font: 600 2.8cqw/1.3 var(--sans); }
  .panel-body :global(.tag) { justify-self: end; background: var(--accent); color: #141414; padding: 1.2cqw 1.8cqw; font: 600 2.3cqw/1.3 var(--mono); }
  .panel-body :global(.mono) { font-family: var(--mono); }
  .panel-body :global(.label-sm) { font: 500 2.2cqw/1 var(--mono); text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); }
  .panel-body :global(.flow-arrow) { font: 600 4cqw/1 var(--sans); text-align: center; }
  .panel-body :global(.phone) { width: 100%; max-width: 30cqw; aspect-ratio: 1 / 1.9; justify-self: center; border: 1.1cqw solid #2b2b2b; border-radius: 3.6cqw; background: var(--surface); padding: 3.6cqw 2.2cqw; display: flex; flex-direction: column; gap: 1.6cqw; }
  /* Ledger: one shared number column, sized to the widest number and right-aligned, so digits line up
     and every label starts at the same short distance from its number. */
  .panel-body :global(.ledger) { position: absolute; inset: 6cqw 8cqw; display: grid; grid-template-columns: max-content 1fr; column-gap: 3.5cqw; row-gap: 1.6cqw; align-content: center; }
  .panel-body :global(.ledger div) { display: grid; grid-column: 1 / -1; grid-template-columns: subgrid; align-items: baseline; border-bottom: 1px solid var(--line); padding-bottom: 1.6cqw; font-size: 3cqw; }
  .panel-body :global(.ledger span) { font: 400 6.5cqw/1 var(--serif); letter-spacing: -0.02em; text-align: right; }

  @media (max-width: 900px) {
    .chapter, .chapter:nth-of-type(even) { grid-template-columns: 1fr; gap: 24px; padding: 48px 0; }
    .chapter:nth-of-type(even) .panel { order: 0; }
    .text :global(p.lede) { font-size: 19px; }
  }
</style>
