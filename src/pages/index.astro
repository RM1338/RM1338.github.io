---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { hasResume } from '../lib/site';
import Ev from '../components/Ev.astro';
import { figures } from '../components/figures';
import { contributions } from '../lib/github';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const [flagship, ...rest] = work;

const capabilities = [
  { title: 'Grounded AI', text: 'Bugs found by the app’s own log, edits stopped by hooks. Never a model’s opinion of what is broken.' },
  { title: 'Cross-platform systems', text: 'A Go daemon, sync server and hook adapters for three coding agents on Linux, macOS and Windows.' },
  { title: 'Research to release', text: 'Ten user interviews and a go/no-go gate before Crewbo’s first line; three public releases of Scribe.' },
];

// Every date below is from a repository's git history or a published release.
const activity = await contributions();
const level = (n: number) => (n === 0 ? 0 : n < 4 ? 1 : n < 10 ? 2 : n < 25 ? 3 : 4);

// Each tool points at the place on this site that shows it in use; null means used, but not shown here.
const toolbox: { group: string; items: [string, string | null, string?][] }[] = [
  { group: 'Languages', items: [['Go', 'Crewbo', '/work/crewbo'], ['Python', 'Gremlin', '/work/gremlin'], ['Dart', 'Scribe', '/work/scribe'], ['TypeScript', 'Crewbo, this site', '/work/crewbo'], ['JavaScript', 'Gremlin console', '/work/gremlin'], ['SQL', 'Scribe', '/work/scribe'], ['C', null]] },
  { group: 'AI and agents', items: [['Claude Code and Codex hooks', 'Crewbo', '/work/crewbo'], ['MCP servers', 'Crewbo', '/work/crewbo'], ['Whisper', 'Scribe', '/work/scribe'], ['GPT-OSS, Gemini, Qwen3-VL', 'Scribe, Gremlin', '/work/gremlin'], ['Local models with Ollama', 'Gremlin', '/work/gremlin'], ['LangChain, LangGraph, RAG', null]] },
  { group: 'Apps and web', items: [['Flutter', 'Scribe', '/work/scribe'], ['React', 'Gremlin', '/work/gremlin'], ['FastAPI', 'Gremlin', '/work/gremlin'], ['VS Code extensions', 'Crewbo', '/work/crewbo'], ['Astro', 'this site', '/'], ['Next.js, Tailwind CSS', null]] },
  { group: 'Data and infrastructure', items: [['SQLite', 'Crewbo', '/work/crewbo'], ['Supabase, PostgreSQL', 'Scribe', '/work/scribe'], ['WebSocket, Protobuf', 'Crewbo', '/work/crewbo'], ['Docker', 'Gremlin sandbox', '/work/gremlin'], ['Linux, dnsmasq, PXE', 'lab rollout post', '#writing'], ['GitHub Actions', 'this site', '/'], ['Redis, Google Cloud', null]] },
  { group: 'Testing and tooling', items: [['adb, Android emulator', 'Gremlin', '/work/gremlin'], ['Playwright', 'Gremlin', '/work/gremlin'], ['Chrome DevTools Protocol', 'Gremlin', '/work/gremlin'], ['git merge-tree', 'Crewbo', '/work/crewbo']] },
];

const timeline = [
  { date: 'Mar 2026', what: 'Started Scribe', ev: 'measured' },
  { date: '12 Jul 2026', what: 'Scribe v0.1.0 released on Android', ev: 'measured' },
  { date: '15 Jul 2026', what: 'Started Gremlin as a research project', ev: 'measured' },
  { date: '21 Aug 2026', what: 'Gremlin’s first real autofix: a correct fix rejected by gate 3, logged as G2', ev: 'measured' },
  { date: '31 Aug 2026', what: 'Scribe v0.1.2 released', ev: 'measured' },
  { date: '11 Oct 2026', what: 'Crewbo: 10 team interviews done, go decision taken', ev: 'measured' },
  { date: '18 Oct 2026', what: 'Crewbo preview: 109 pull requests merged; Gremlin open-sourced', ev: 'measured' },
  { date: 'Nov 2026', what: 'Crewbo’s first real hackathon (planned)', ev: 'not yet measured' },
] as const;

// ponytail: copied by hand from https://medium.com/feed/@ronelmathew; refresh when a post is published.
const posts = [
  {
    title: 'Zero-Touch OS Deployment: Migrating 90 Lab Systems with PXE',
    date: '6 Aug 2026',
    text: 'Moving a 90-machine college lab from Ubuntu 22.04 to 24.04 in one weekend over network boot, and the DHCP option 93 mistake that silently stopped machines from booting.',
    tags: ['Linux', 'PXE', 'DHCP', 'Ubuntu'],
    href: 'https://medium.com/@ronelmathew/zero-touch-os-deployment-migrating-90-lab-systems-with-pxe-15e25b62e979',
  },
];

const steps = [
  { n: '01', title: 'Research', text: 'Interviews and throwaway spikes on every OS before any plan.' },
  { n: '02', title: 'Decide', text: 'A decision record for anything costly to reverse; a gate before each milestone.' },
  { n: '03', title: 'Build', text: 'Small changes under written rules: verify every fact, claim nothing that was not run.' },
  { n: '04', title: 'Verify', text: 'Live checks across machines and operating systems before anything merges.' },
];
---

<Base
  title="Ronel Abraham Mathew · AI Engineer"
  description="AI Engineer and founder of Crewbo. I build agents, and the checks that make them safe to trust."
>
  <section class="hero wrap">
    <div class="status-bar">
      <div class="fact fact-accent"><span class="label">Building</span><span>Crewbo</span></div>
      <div class="fact"><span class="label">Role</span><span>AI Engineer</span></div>
      <div class="fact"><span class="label">Open to</span><span>AI Engineer roles</span></div>
      <a class="btn btn-solid get" href="mailto:rma80070@gmail.com">Get in touch</a>
    </div>
    <p class="label kicker">AI Engineer · Founder of Crewbo</p>
    <h1>I build agents, and the checks that make them safe to trust.</h1>
    <p class="sub">
      Tools for AI coding agents: safe to run side by side in a team, and checked against ground truth instead
      of a model’s opinion.
    </p>
    <div class="ctas">
      <a class="btn btn-solid" href="/work/crewbo">See Crewbo</a>
      {hasResume && <a class="btn" href="/resume.pdf" target="_blank" rel="noopener">Résumé ↗</a>}
      <a class="mail" href="mailto:rma80070@gmail.com">rma80070@gmail.com</a>
    </div>
  </section>

  <section class="caps wrap" aria-label="Capabilities">
    {
      capabilities.map((c) => (
        <div class="cap">
          <h3 class="label">{c.title}</h3>
          <p>{c.text}</p>
        </div>
      ))
    }
  </section>

  <section class="work wrap" id="work">
    <p class="label">01 Selected work</p>
    {
      [flagship, ...rest].map((p, i) => (
        <article class:list={['card', { 'card-flagship': i === 0 }]}>
          <div class="card-media">{(() => { const F = figures[p.id as keyof typeof figures]; return <F />; })()}</div>
          <div class="card-body">
            <p class="label">{p.data.kind}</p>
            <p class={`status status-${p.data.status.tone}`}>{p.data.status.label}</p>
            <h2>
              <a href={`/work/${p.id}`}>{p.data.title}</a>
            </h2>
            <p class="tagline">{p.data.tagline}</p>
            <ul class="hl">
              {p.data.highlights.map((h) => (
                <li>
                  {h.text} <Ev e={h.evidence} />
                </li>
              ))}
            </ul>
            <p class="card-links">
              <a href={`/work/${p.id}`}>Case study →</a>
              {p.data.links.filter((l) => l.href).map((l) => <a href={l.href}>{l.label} ↗</a>)}
            </p>
          </div>
        </article>
      ))
    }
  </section>

  <section class="tools wrap" id="toolbox">
    <p class="label">02 Toolbox</p>
    <h2>What I build with, and where you can see it.</h2>
    <div class="tool-grid">
      {
        toolbox.map((g) => (
          <div class="tool-group">
            <h3 class="label">{g.group}</h3>
            <ul>
              {g.items.map(([name, where, href]) => (
                <li>
                  <span>{name}</span>
                  {where ? <a class="mono where" href={href}>{where} →</a> : <span class="mono where muted">used, not shown here</span>}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section class="tl wrap" id="timeline">
    <p class="label">03 Timeline</p>
    <h2>2026, in order.</h2>
    <ol>
      {
        timeline.map((t) => (
          <li>
            <span class="mono when">{t.date}</span>
            <span>{t.what}</span>
            {t.ev !== 'measured' && <Ev e={t.ev} />}
          </li>
        ))
      }
    </ol>
    {
      activity && (
        <figure class="activity">
          <div class="cal" role="img" aria-label={`${activity.total} GitHub contributions in the last year`}>
            {activity.weeks.map((w) => (
              <div class="wk">{w.map((d) => <i class={`l${level(d.count)}`} title={`${d.date}: ${d.count}`} />)}</div>
            ))}
          </div>
          <figcaption class="mono">
            {activity.total.toLocaleString('en')} contributions on <a href="https://github.com/RM1338">GitHub</a> in the last year
          </figcaption>
        </figure>
      )
    }
  </section>

  <section class="writing wrap" id="writing">
    <p class="label">04 Writing</p>
    <h2>Notes from the field.</h2>
    {
      posts.map((p) => (
        <a class="post" href={p.href}>
          <span class="mono when">{p.date} · Medium</span>
          <span class="post-title">{p.title} ↗</span>
          <span class="muted">{p.text}</span>
          <span class="post-tags mono">{p.tags.join(' · ')}</span>
        </a>
      ))
    }
    <p><a href="https://medium.com/@ronelmathew">All posts on Medium ↗</a></p>
  </section>

  <section class="how wrap" id="how">
    <p class="label">05 How I work</p>
    <h2>Rules first, then code, then proof.</h2>
    <ol class="steps">
      {
        steps.map((s) => (
          <li>
            <span class="label">{s.n}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ol>
    <p class="muted">The full record for Crewbo is in its <a href="/work/crewbo">case study</a>.</p>
  </section>

  <section class="about wrap" id="about">
    <p class="label">06 About</p>
    <div class="about-text">
      <p>
        I’m Ronel. I build software that lets AI agents act without asking anyone to trust their judgement. That
        started with Scribe, a meeting recorder I shipped on my own, became a research project in Gremlin, and is now Crewbo, my startup.
      </p>
      <dl class="facts">
        <div>
          <dt class="label">Now</dt>
          <dd>AI Engineer Trainee, Karunya Innovation and Design Studio <span class="muted">· Dec 2025 to now</span></dd>
          <dd class="muted">Agentic AI systems and generative AI prototypes: tool-using agents and multi-step reasoning workflows.</dd>
        </div>
        <div>
          <dt class="label">Study</dt>
          <dd>B.Tech, Computer Science and Engineering, Karunya Institute of Technology and Sciences <span class="muted">· 2025 to 2029</span></dd>
        </div>
        <div>
          <dt class="label">Before</dt>
          <dd>Technical Trainee, Google Developer Group on Campus Karunya <span class="muted">· Oct 2025 to Jun 2026</span></dd>
        </div>
      </dl>
      <p>
        Every number on this site carries a tag saying how solid it is: <Ev e="measured" />, <Ev e="self-reported" />
        or <Ev e="not yet measured" />. I would rather show you the limits than have you find them.
      </p>
    </div>
  </section>
</Base>

<style>
  .hero { padding-top: 24px; }
  .status-bar {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr)) auto;
    gap: 16px;
    align-items: start;
    padding-bottom: 96px;
  }
  .fact { display: flex; flex-direction: column; gap: 2px; padding: 12px 14px; }
  .fact-accent { background: var(--accent); color: #141414; }
  .fact-accent .label { color: #141414; opacity: 0.7; }
  .get { align-self: center; }
  .kicker { margin-bottom: 20px; }
  h1 {
    font-size: clamp(48px, 9vw, 136px);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 0.95;
    max-width: 14ch;
  }
  .sub { font-size: clamp(18px, 2vw, 22px); max-width: 40ch; margin-top: 32px; color: var(--muted); }
  .ctas { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px; margin-top: 32px; }
  .mail { font: 500 14px/1.4 var(--mono); }

  .caps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: 96px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .cap { padding: 24px 24px 8px 0; }
  .cap + .cap { padding-left: 24px; border-left: 1px solid var(--line); }
  .cap h3 { color: var(--ink); margin-bottom: 8px; }
  .cap p { font-size: 16px; color: var(--muted); }

  .work { margin-top: var(--section); display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .work > .label { grid-column: 1 / -1; }
  .card { display: grid; grid-template-rows: auto 1fr; border: 1px solid var(--line); background: var(--surface); }
  .card-flagship { grid-column: 1 / -1; grid-template-columns: 7fr 5fr; grid-template-rows: auto; }
  .card-media { border-bottom: 1px solid var(--line); }
  .card-flagship .card-media { border-bottom: 0; border-right: 1px solid var(--line); }
  .card-body { padding: 24px; display: flex; flex-direction: column; gap: 10px; }
  .card-body h2 a { text-decoration: none; }
  .tagline { margin: 0; }
  .hl { margin: 0; padding: 0; list-style: none; display: grid; gap: 8px; font-size: 16px; }
  .hl li::before { content: '– '; color: var(--muted); }
  .card-links { margin-top: auto; padding-top: 8px; display: flex; flex-wrap: wrap; gap: 8px 20px; font-weight: 500; }

  .tools { margin-top: var(--section); }
  .tools h2 { margin: 16px 0 32px; max-width: 22ch; }
  .tool-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 0 32px; }
  .tool-group { border-top: 1.5px solid var(--ink); padding: 16px 0 24px; }
  .tool-group h3 { color: var(--ink); margin-bottom: 8px; }
  .tool-group ul { list-style: none; margin: 0; padding: 0; }
  .tool-group li { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; padding: 8px 0; border-bottom: 1px solid var(--line); font-size: 16px; }
  .where { font-size: 12px; text-decoration: none; white-space: nowrap; }
  a.where { color: var(--accent); }
  .activity { margin: 32px 0 0; }
  /* 53 week columns that share the full width, so the graph spans the column instead of hugging the left. */
  .cal { display: grid; grid-template-columns: repeat(53, minmax(8px, 1fr)); gap: 3px; overflow-x: auto; padding-bottom: 4px; }
  .wk { display: grid; grid-template-rows: repeat(7, auto); gap: 3px; align-content: start; }
  .wk i { display: block; width: 100%; aspect-ratio: 1; background: var(--line); }
  .wk i.l1 { background: #ffd2bf; } .wk i.l2 { background: #ffa47f; } .wk i.l3 { background: #ff763f; } .wk i.l4 { background: var(--accent); }
  .activity figcaption { margin-top: 10px; font-size: 13px; color: var(--muted); text-align: center; }
  .tl { margin-top: var(--section); }
  .tl h2 { margin: 16px 0 32px; }
  .tl ol { list-style: none; margin: 0; padding: 0; border-top: 1.5px solid var(--ink); }
  .tl li { display: grid; grid-template-columns: 160px 1fr auto; gap: 16px; align-items: baseline; padding: 16px 0; border-bottom: 1px solid var(--line); }
  .when { font-size: 13px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.04em; }
  @media (max-width: 720px) { .tl li { grid-template-columns: 1fr; gap: 4px; } }
  .writing { margin-top: var(--section); }
  .writing h2 { margin: 16px 0 32px; }
  .post { display: grid; gap: 10px; padding: 28px; border: 1.5px solid var(--ink); background: var(--surface); text-decoration: none; max-width: 860px; margin-bottom: 20px; }
  .post:hover { border-color: var(--accent); }
  .post:hover .post-title { color: var(--accent); }
  .post-title { font-size: clamp(22px, 2.6vw, 30px); font-weight: 700; letter-spacing: -0.02em; line-height: 1.2; }
  .post-tags { font-size: 12px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); }
  .how { margin-top: var(--section); }
  .how h2 { margin: 16px 0 40px; max-width: 20ch; }
  .steps { list-style: none; padding: 0; margin: 0 0 24px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
  .steps li { border-top: 2px solid var(--ink); padding-top: 16px; }
  .steps h3 { margin: 8px 0; }
  .steps p { font-size: 16px; color: var(--muted); }

  .about { margin-top: var(--section); display: grid; grid-template-columns: 1fr 2fr; gap: 24px; }
  .about-text { max-width: 60ch; }
  .facts { margin: 8px 0 28px; border-top: 1.5px solid var(--ink); }
  .facts div { padding: 14px 0; border-bottom: 1px solid var(--line); }
  .facts dd { margin: 4px 0 0; font-size: 16px; }

  @media (max-width: 960px) {
    .card-flagship { grid-template-columns: 1fr; }
    .card-flagship .card-media { border-right: 0; border-bottom: 1px solid var(--line); }
    .steps { grid-template-columns: 1fr 1fr; }
    .caps { grid-template-columns: 1fr; }
    .cap + .cap { padding-left: 0; border-left: 0; border-top: 1px solid var(--line); }
  }
  @media (max-width: 720px) {
    .status-bar { grid-template-columns: 1fr 1fr; padding-bottom: 56px; }
    .get { display: none; }
    .fact-accent { grid-column: 1 / -1; }
    .work { grid-template-columns: 1fr; }
    .steps { grid-template-columns: 1fr; }
    .about { grid-template-columns: 1fr; }
  }
</style>
